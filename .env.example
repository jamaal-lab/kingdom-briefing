# Copy to .env (local) or set in your host's dashboard. Never commit real values.
# VITE_* values are baked in at BUILD time and are public (they ship to browsers).
# Everything else is read by the server at RUNTIME and stays private.

# ── Build time (public) ─────────────────────────────────────────────
# Absolute origin used for canonical URLs, og:image and the sitemap.
VITE_SITE_URL=https://staging.example.com
# "production" allows search indexing. Anything else (default) = noindex + robots Disallow.
VITE_SITE_ENV=staging
# 1 = show the on-site inquiry form next to the email action (also needs INQUIRY_ENABLED=1).
VITE_INQUIRY_FORM=0
# "endpoint" = beacon client errors to /api/client-errors (also needs ERROR_REPORTING_ENABLED=1).
VITE_ERROR_REPORTING=off

# ── Runtime (secret / server only) ──────────────────────────────────
# "user:password" — require HTTP Basic auth on every page and API route (staging).
STAGING_BASIC_AUTH=
# 1 = accept POST /api/inquiry. Off by default.
INQUIRY_ENABLED=0
# Delivery adapter. Only "log" exists (redacted structured log line). Email/CRM adapters need approval.
INQUIRY_DELIVERY=log
# 1 = accept POST /api/client-errors and log them as structured JSON.
ERROR_REPORTING_ENABLED=0
# Port for `npm start` (Node preset).
PORT=3000

# ── /websites build (SITE_TARGET=websites npm run build:websites) ─────────────
# Project intake delivery. Unset = OFF: the endpoint answers 503 and the page
# offers "Email my answers" instead (never a false success).
#   log      redacted log line only (staging tests; stores no personal data)
#   webhook  signed JSON POST to INTAKE_WEBHOOK_URL (LeadConnector inbound webhook, Zapier, Make, …)
INTAKE_DELIVERY=
INTAKE_WEBHOOK_URL=
# ≥16 chars. Set as a platform secret, never in this file. The receiver verifies
# header x-btbs-signature: sha256=HMAC_SHA256(secret, raw body).
INTAKE_WEBHOOK_SECRET=
# Submissions per client IP per 15 minutes (default 4).
INTAKE_RATE_LIMIT=

{
  "name": "bridge-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=desktop --project=tablet --project=mobile",
    "check": "npm run typecheck && npm run build && npm test",
    "build:preview": "vite build --config vite.preview.config.ts",
    "render:assets": "node scripts/render-assets.mjs",
    "render:og": "node scripts/render-og.mjs",
    "build:websites": "SITE_TARGET=websites vite build",
    "start:websites": "node .output-websites/server/index.mjs",
    "render:websites": "node scripts/render-websites-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "nitro": "3.0.260903-beta",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
